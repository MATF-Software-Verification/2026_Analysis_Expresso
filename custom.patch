diff --git a/Expresso/tests/binaryserializer_test.cpp b/Expresso/tests/binaryserializer_test.cpp
new file mode 100644
index 0000000..44554c0
--- /dev/null
+++ b/Expresso/tests/binaryserializer_test.cpp
@@ -0,0 +1,30 @@
+#include "../src/artikl.h"
+#include "../src/binaryserializer.h"
+#include <QTemporaryDir>
+#include <catch.hpp>
+
+TEST_CASE("BinarySerializer - save/load round-trip", "[class]") {
+  QTemporaryDir dir;
+  REQUIRE(dir.isValid());
+  BinarySerializer serializer(dir.path());
+
+  SECTION("Sacuvan i ucitan Artikl ima iste podatke") {
+    Artikl original("Espresso", 150, "Kafa", 2);
+    serializer.save(original, "artikal.bin");
+
+    Artikl ucitan;
+    serializer.load(ucitan, "artikal.bin");
+
+    REQUIRE(ucitan.getNaziv() == "Espresso");
+    REQUIRE(ucitan.getCena() == 150);
+    REQUIRE(ucitan.getKategorija() == "Kafa");
+    REQUIRE(ucitan.getKolicina() == 2);
+  }
+
+  SECTION("load() iz nepostojeceg fajla ostavlja objekat nepromenjen") {
+    Artikl a("Cola", 200, "Sokovi");
+    serializer.load(a, "nepostojeci.bin");
+    REQUIRE(a.getNaziv() == "Cola");
+    REQUIRE(a.getCena() == 200);
+  }
+}
diff --git a/Expresso/tests/izvestaj_test.cpp b/Expresso/tests/izvestaj_test.cpp
new file mode 100644
index 0000000..c4075c2
--- /dev/null
+++ b/Expresso/tests/izvestaj_test.cpp
@@ -0,0 +1,68 @@
+#include "../src/izvestaj.h"
+#include <QDate>
+#include <QFile>
+#include <catch.hpp>
+
+namespace {
+
+struct DnevniIzvestajCleanup {
+  QString filename;
+
+  explicit DnevniIzvestajCleanup(const QDate &datum)
+      : filename("racuni_" + datum.toString("yyyy_MM_dd") + ".txt") {
+    QFile::remove(filename);
+  }
+
+  ~DnevniIzvestajCleanup() {
+    QFile::remove(filename);
+  }
+};
+
+} // namespace
+
+TEST_CASE("Izvestaj - cuvanje i ucitavanje dnevnog izvestaja", "[class]") {
+  izvestaj iz;
+  QDate danas = QDate::currentDate();
+  DnevniIzvestajCleanup cleanup(danas);
+
+  SECTION("Sacuvan racun se pojavljuje u tekstu dnevnog izvestaja") {
+    iz.sacuvajRacun(250.0, "Kafa i kolac");
+    QString tekst = iz.ucitajdnevniizvestaj(danas);
+
+    REQUIRE_FALSE(tekst.isEmpty());
+    REQUIRE(tekst.contains("Kafa i kolac"));
+  }
+
+  SECTION("ucitajdnevniizvestaj za dan bez racuna vraca prazan string") {
+    QString tekst = iz.ucitajdnevniizvestaj(danas);
+    REQUIRE(tekst.isEmpty());
+  }
+
+  SECTION("dnevniPrihod tacno sabira iznose svih sacuvanih racuna") {
+    iz.sacuvajRacun(250.0, "Kafa i kolac");
+    iz.sacuvajRacun(150.0, "Sok");
+
+    double prihod = iz.dnevniPrihod(danas);
+    REQUIRE(prihod == Approx(400.0));
+  }
+
+  SECTION("ucitajMesecniIzvestaj spaja dnevne izvestaje kao tekst") {
+    iz.sacuvajRacun(200.0, "Kafa");
+    QString mesecni = iz.ucitajMesecniIzvestaj(danas);
+
+    REQUIRE(mesecni.contains("Kafa"));
+  }
+
+  SECTION("Poznati problem sa racunanjem mesecnog prihoda") {
+    iz.sacuvajRacun(200.0, "Kafa");
+
+    double mesecniPrihod = iz.ukupniPrihodMesec(danas);
+    QDate najprometniji = iz.najprometnijiDanMesec(danas);
+    QDate najmanjePrometan = iz.najmanjePrometanDanMesec(danas);
+
+    REQUIRE(mesecniPrihod == 0.0);
+    REQUIRE_FALSE(najprometniji.isValid());
+    REQUIRE(najmanjePrometan ==
+            QDate(danas.year(), danas.month(), 1));
+  }
+}
