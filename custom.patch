+#include "../src/artikl.h"
+#include "../src/meni.h"
+#include <catch.hpp>
+
+TEST_CASE("Meni - kategorije, artikli, serijalizacija", "[class]") {
+  SECTION("addCategory dodaje novu kategoriju") {
+    Meni meni;
+    meni.addCategory("Sokovi");
+    REQUIRE(meni.getKategorije().size() == 1);
+    REQUIRE(meni.getKategorije().contains("Sokovi"));
+  }
+
+  SECTION("addItem dodaje artikal u postojecu kategoriju") {
+    Meni meni;
+    meni.addCategory("Sokovi");
+    Artikl *a = new Artikl("Fanta", 180, "Sokovi");
+    int rezultat = meni.addItem("Sokovi", a);
+    REQUIRE(rezultat == 0);
+  }
+
+  SECTION("deleteCategory uklanja kategoriju iz mape") {
+    Meni meni;
+    meni.addCategory("Sokovi");
+    REQUIRE(meni.getKategorije().size() == 1);
+
+    meni.deleteCategory("Sokovi");
+    REQUIRE(meni.getKategorije().size() == 0);
+  }
+
+  SECTION("toVariant/fromVariant round-trip cuva kategorije i artikle") {
+    Meni meni;
+    meni.addCategory("Sokovi");
+    Artikl *a = new Artikl("Fanta", 180, "Sokovi");
+    meni.addItem("Sokovi", a);
+
+    QVariant sacuvano = meni.toVariant();
+
+    Meni ucitan;
+    ucitan.fromVariant(sacuvano);
+
+    REQUIRE(ucitan.getKategorije().size() == 1);
+    REQUIRE(ucitan.getKategorije().contains("Sokovi"));
+    REQUIRE(ucitan.getKategorije()["Sokovi"]->getArtikli().size() == 1);
+  }
+}
