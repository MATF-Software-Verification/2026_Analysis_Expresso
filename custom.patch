index 0000000..cc86e83
--- /dev/null
+++ b/Expresso/tests/sto_extra_test.cpp
@@ -0,0 +1,69 @@
+#include "../src/meni.h"
+#include "../src/sto.h"
+#include <catch.hpp>
+
+TEST_CASE("Sto - dodatni testovi (getteri/setteri, serijalizacija)",
+          "[class]") {
+  SECTION("Podrazumevane vrednosti posle konstrukcije") {
+    Sto *sto = new Sto(7);
+    REQUIRE(sto->getId() == 7);
+    REQUIRE(sto->getWidth() == 150);
+    REQUIRE(sto->getHeight() == 150);
+    REQUIRE(sto->getNumSeats() == 4);
+    REQUIRE(sto->getStatus() == Sto::AVAILABLE);
+    delete sto;
+  }
+
+  SECTION("Setteri menjaju stanje kako se ocekuje") {
+    Sto *sto = new Sto(1);
+    sto->setNumSeats(6);
+    sto->setDegree(45);
+    sto->setWidth(200);
+    sto->setHeight(100);
+    sto->setColor(QColor(Qt::red));
+    sto->setStatus(Sto::OCCUPIED);
+
+    REQUIRE(sto->getNumSeats() == 6);
+    REQUIRE(sto->getDegree() == 45);
+    REQUIRE(sto->getWidth() == 200);
+    REQUIRE(sto->getHeight() == 100);
+    REQUIRE(sto->getColor() == QColor(Qt::red));
+    REQUIRE(sto->getStatus() == Sto::OCCUPIED);
+    delete sto;
+  }
+
+  SECTION("toVariant/fromVariant round-trip cuva broj mesta i poziciju") {
+    Sto *sto = new Sto(3);
+    sto->setMeni(new Meni());
+    sto->setNumSeats(8);
+    sto->setPos(120, 45);
+
+    QVariant sacuvano = sto->toVariant();
+
+    Sto *ucitan = new Sto(0);
+    ucitan->setMeni(new Meni());
+    ucitan->fromVariant(sacuvano);
+
+    REQUIRE(ucitan->getId() == 3);
+    REQUIRE(ucitan->getNumSeats() == 8);
+    REQUIRE(ucitan->pos() == QPointF(120, 45));
+
+    delete sto;
+    delete ucitan;
+  }
+
+  SECTION("fromVariant postavlja podrazumevani Meni") {
+    Sto *sto = new Sto(5);
+    REQUIRE(sto->getMeni() == nullptr);
+
+    QVariantMap map;
+    map.insert("id", 5);
+    map.insert("position", QPointF(0, 0));
+    map.insert("m_numSeats", 4);
+    map.insert("meni", Meni().toVariant());
+    sto->fromVariant(map);
+
+    REQUIRE(sto->getMeni() != nullptr);
+    delete sto;
+  }
+}
