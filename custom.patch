@@ -0,0 +1,31 @@
+#include "../src/raspored.h"
+#include "../src/rasporeddata.h"
+#include <QTemporaryDir>
+#include <catch.hpp>
+
+TEST_CASE("RasporedData - save/load round-trip u pravom direktorijumu",
+          "[class]") {
+  QTemporaryDir dir;
+  REQUIRE(dir.isValid());
+
+  SECTION("Sacuvan raspored se ucita nazad pod istim nazivom") {
+    RasporedData rasporedData(dir.path());
+    Raspored *r = new Raspored("TestRaspored");
+    r->setMaxTables(5);
+    rasporedData.addRaspored(r);
+
+    rasporedData.executeSave();
+
+    RasporedData ucitano(dir.path());
+    ucitano.executeLoad();
+
+    REQUIRE(ucitano.getRasporedi()->size() == 1);
+    REQUIRE(ucitano.getRasporedi()->contains("TestRaspored"));
+  }
+
+  SECTION("Prazan direktorijum ucitava nula rasporeda") {
+    RasporedData rasporedData(dir.path());
+    rasporedData.executeLoad();
+    REQUIRE(rasporedData.getRasporedi()->size() == 0);
+  }
+}
diff --git a/Expresso/tests/sto_extra_test.cpp b/Expresso/tests/sto_extra_test.cpp
