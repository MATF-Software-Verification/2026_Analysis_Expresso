@@ -0,0 +1,61 @@
+#include "../src/artikl.h"
+#include "../src/kategorija.h"
+#include <catch.hpp>
+
+TEST_CASE("Kategorija - dodavanje, pretraga i brisanje artikala", "[class]") {
+  Kategorija kat("Sokovi");
+
+  SECTION("Dodat artikal se pojavljuje u getArtikli()") {
+    Artikl *a = new Artikl("Fanta", 180, "Sokovi");
+    int rezultat = kat.dodajArtikl(a);
+
+    REQUIRE(rezultat == 0);
+    REQUIRE(kat.getArtikli().size() == 1);
+    REQUIRE(kat.getArtikli()[0]->getNaziv() == "Fanta");
+
+    kat.obrisiArtikl("Fanta");
+    delete a;
+  }
+
+  SECTION("Dodavanje artikla sa vec postojecim nazivom se odbija") {
+    Artikl *a1 = new Artikl("Fanta", 180, "Sokovi");
+    Artikl *a2 = new Artikl("Fanta", 999, "Sokovi");
+    kat.dodajArtikl(a1);
+    int rezultat = kat.dodajArtikl(a2);
+
+    REQUIRE(rezultat == 1);
+    REQUIRE(kat.getArtikli().size() == 1);
+
+    kat.obrisiArtikl("Fanta");
+    delete a1;
+    delete a2;
+  }
+
+  SECTION("getArtiklByNaziv pronalazi dodat artikal") {
+    Artikl *a = new Artikl("Sprite", 170, "Sokovi");
+    kat.dodajArtikl(a);
+
+    Artikl *found = kat.getArtiklByNaziv("Sprite");
+    REQUIRE(found != nullptr);
+    REQUIRE(found->getCena() == 170);
+
+    kat.obrisiArtikl("Sprite");
+    delete a;
+  }
+
+  SECTION("getArtiklByNaziv vraca nullptr za nepostojeci naziv") {
+    Artikl *found = kat.getArtiklByNaziv("NePostoji");
+    REQUIRE(found == nullptr);
+  }
+
+  SECTION("obrisiArtikl uklanja artikal po nazivu") {
+    Artikl *a = new Artikl("Kokakola", 150, "Sokovi");
+    kat.dodajArtikl(a);
+    REQUIRE(kat.getArtikli().size() == 1);
+
+    kat.obrisiArtikl("Kokakola");
+    REQUIRE(kat.getArtikli().size() == 0);
+
+    delete a;
+  }
+}
